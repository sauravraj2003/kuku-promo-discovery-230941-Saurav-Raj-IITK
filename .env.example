# Set these in the backend process environment; this file is not loaded automatically.
# rules is an explicit NON-AI baseline. ollama requires a running model server.
KUKU_PROVIDER=rules
KUKU_MODEL_URL=http://127.0.0.1:11434
KUKU_MODEL_NAME=
KUKU_MODEL_REVISION=
KUKU_MODEL_TIMEOUT=60
KUKU_MODEL_CONTEXT=16384
# Optional bearer token for your configured model endpoint. Never set frontend secrets.
KUKU_API_KEY=
# Defaults: repository screenplay directory, data/kuku.sqlite3
# KUKU_SOURCE_DIR=
# KUKU_DB_PATH=
